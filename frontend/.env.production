# Production API base URL — baked into the bundle by `vite build` (mode=production).
# The Capacitor Android app in production talks to this HTTPS endpoint; HTTPS is
# mandatory for the camera API to work in the WebView.
VITE_API_BASE_URL=https://fit.idone.co.il/api/v1

# Optional error tracking. Leave unset to run with telemetry disabled.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
