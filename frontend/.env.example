# API base URL (used by src/api/client.ts). Defaults to the local dev server
# (http://localhost:8000/api/v1) when unset. For a production build, set this
# in frontend/.env.production to the deployed HTTPS endpoint.
# VITE_API_BASE_URL=https://fit.idone.co.il/api/v1

# Sentry error tracking (optional).
# Leave unset to run with telemetry fully disabled. When set, the SDK is
# initialized with sendDefaultPii=false and a PII scrubber — no camera
# frames, video data, or user identifiers are ever sent.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
