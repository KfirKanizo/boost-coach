# Copy to `deploy/.env` and fill in real secrets. NEVER commit `.env`.
# docker compose -f docker-compose.prod.yml automatically interpolates these.

# PostgreSQL
POSTGRES_USER=boostcoach
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=boostcoach

# JWT signing secret. REQUIRED in production — generate with:
#   openssl rand -hex 32
# (Dev fallback randomizes per boot, which would invalidate sessions on restart.)
SECRET_KEY=

# Optional error tracking (Sentry). Leave empty to disable.
SENTRY_DSN=

# Optional LLM coach (OpenAI-compatible). Leave empty to run on local fallback.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
