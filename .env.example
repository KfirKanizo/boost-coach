# PostgreSQL
POSTGRES_USER=boostcoach
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=boostcoach

# API
APP_ENV=development
DEBUG=true
DB_ECHO=false

# JWT signing secret. REQUIRED in production; a random per-boot key is used
# as a development fallback when unset.
SECRET_KEY=dev-only-change-me-in-prod

# Full override (used by the api container; defaults are assembled in docker-compose.yml)
# DATABASE_URL=postgresql+asyncpg://boostcoach:change-me-in-prod@db:5432/boostcoach

# LLM Coach (OpenAI-compatible provider, optional).
# Leave unset to run the Coach on local fallback feedback.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Sentry error tracking (optional; backend reads this from the api container).
# Leave unset to run with telemetry fully disabled. Privacy by design: the SDK
# is initialized with send_default_pii=false and a before_send PII scrubber.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Sentry error tracking (optional; frontend — create frontend/.env with this).
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
